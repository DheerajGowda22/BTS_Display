# Normalise line endings so shell scripts and configs work the same on Windows and Linux.
* text=auto

*.sh    text eol=lf
Dockerfile text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.js    text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.md    text eol=lf

*.xlsx  binary
*.png   binary
*.jpg   binary
*.ico   binary