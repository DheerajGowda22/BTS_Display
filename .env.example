# Copy to .env (local) or set these in your hosting dashboard.
# The server reads real environment variables; it does not load this file.
PORT=3000
# Where the SQLite database lives. Must be a persistent disk/volume in production.
DATA_DIR=./data
# Required to use the Staff desk (job upload, export, clear). Use 6+ digits.
STAFF_PIN=change-me
# Answers allowed per device (IP) per minute. Raise it if the booth Wi-Fi puts everyone behind one IP.
MAX_SUBMITS_PER_MIN=60